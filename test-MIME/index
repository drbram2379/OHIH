.btn { border: 1px solid var(--color-border); background: #fff; color: var(--color-text-primary); border-radius: var(--radius-control); padding: 7px 13px; font-size: var(--type-caption); font-weight: 600; display: flex; align-items: center; gap: 6px; cursor: pointer; font-family: var(--type-family-body); transition: border-color var(--motion-fast), color var(--motion-fast); }

  /* Aggregates live worksheet rows into the same governed shape used by the
     certified snapshot. Only the aggregations defined by the Dashboard KPI
     Dictionary are computed — no additional derivation is performed. */
  function aggregateLiveTable(table) {
    var labels = table.cols.map(function (c) { return (c.label || "").trim(); });
    function idx(field) { return labels.indexOf(field); }

    var iId   = idx(MIME_FIELDS.INCIDENT_ID),
        iYear = idx(MIME_FIELDS.INCIDENT_YEAR),
        iMon  = idx(MIME_FIELDS.INCIDENT_MONTH_TXT),
        iSite = idx(MIME_FIELDS.SITE_CODE),
        iCrit = idx(MIME_FIELDS.INCIDENT_CRITERIA),
        iType = idx(MIME_FIELDS.INCIDENT_TYPE),
        iCat  = idx(MIME_FIELDS.INCIDENT_CATEGORY),
        iFit  = idx(MIME_FIELDS.FITNESS_STATUS),
        iTran = idx(MIME_FIELDS.TRANSPORT_MODE),
        iExec = idx(MIME_FIELDS.MEDEVAC_EXECUTOR),
        iMed  = idx(MIME_FIELDS.MEDICAL_STATUS),
        iReh  = idx(MIME_FIELDS.MEDICAL_REHAB_FLAG);

    var agg = {
      total_records: 0, total_raw_rows: table.rows.length,
      by_year: {}, by_site: {}, by_site_year: {}, by_criteria: {}, by_type: {},
      by_category: {}, by_fitness: {}, by_transport: {}, by_executor: {},
      by_medstatus: {}, rehab_flag: {}, by_year_month: {},
      site_type: {}, site_category: {}, site_fitness: {}, site_criteria: {},
      null_site: 0, null_fitness: 0, null_criteria: 0
    };

    function bump(bucket, key) {
      if (key === null || key === undefined || String(key).trim() === "") { return false; }
      bucket[key] = (bucket[key] || 0) + 1;
      return true;
    }
    function cell(row, i) {
      if (i < 0 || !row.c || !row.c[i]) { return null; }
      var v = row.c[i].v;
      return (v === null || v === undefined || String(v).trim() === "") ? null : v;
    }

    table.rows.forEach(function (row) {
      if (cell(row, iId) === null) { return; }
      agg.total_records += 1;

      var year = cell(row, iYear), site = cell(row, iSite), month = cell(row, iMon);
      var crit = cell(row, iCrit), type = cell(row, iType), cat = cell(row, iCat);
      var fit  = cell(row, iFit),  reh  = cell(row, iReh);

      if (year !== null) { bump(agg.by_year, String(parseInt(year, 10))); }
      if (year !== null && month !== null) {
        var y = String(parseInt(year, 10));
        agg.by_year_month[y] = agg.by_year_month[y] || {};
        agg.by_year_month[y][month] = (agg.by_year_month[y][month] || 0) + 1;
      }
      if (site !== null) {
        bump(agg.by_site, site);
        if (year !== null) { bump(agg.by_site_year, site + "|" + parseInt(year, 10)); }
      } else { agg.null_site += 1; }

      if (!bump(agg.by_criteria, crit)) { agg.null_criteria += 1; }
      bump(agg.by_type, type);
      bump(agg.by_category, cat);
      if (!bump(agg.by_fitness, fit)) { agg.null_fitness += 1; }
      bump(agg.by_transport, cell(row, iTran));
      bump(agg.by_executor,  cell(row, iExec));
      bump(agg.by_medstatus, cell(row, iMed));
      if (reh !== null) { bump(agg.rehab_flag, String(reh)); }

      if (site !== null) {
        if (type !== null) { bump(agg.site_type,     site + "|" + type); }
        if (cat  !== null) { bump(agg.site_category, site + "|" + cat);  }
        if (fit  !== null) { bump(agg.site_fitness,  site + "|" + fit);  }
        if (crit !== null) { bump(agg.site_criteria, site + "|" + crit); }
      }
    });

    return agg;
  }

  function loadSnapshot() {
    state.aggregate = JSON.parse(JSON.stringify(MIME_SNAPSHOT));
    state.source = "SNAPSHOT";
    return state.aggregate;
  }

  function loadLive(table) {
    var agg = aggregateLiveTable(table);
    if (!agg.total_records) { throw new Error("Live worksheet returned no usable records"); }
    state.aggregate = agg;
    state.source = "LIVE";
    return agg;
  }

  /* ---- Scoped accessors (site filter applied without re-deriving KPIs) --- */
  function splitByPrefix(map, site) {
    var out = {};
    Object.keys(map || {}).forEach(function (k) {
      var parts = k.split("|");
      if (parts[0] === site) { out[parts[1]] = (out[parts[1]] || 0) + map[k]; }
    });
    return out;
  }

  function criteria(site) { return site === "ALL" ? state.aggregate.by_criteria : splitByPrefix(state.aggregate.site_criteria, site); }
  function types(site)    { return site === "ALL" ? state.aggregate.by_type     : splitByPrefix(state.aggregate.site_type, site); }
  function categories(s)  { return s === "ALL"    ? state.aggregate.by_category : splitByPrefix(state.aggregate.site_category, s); }
  function fitness(site)  { return site === "ALL" ? state.aggregate.by_fitness  : splitByPrefix(state.aggregate.site_fitness, site); }

  return {
    loadSnapshot: loadSnapshot,
    loadLive: loadLive,
    aggregate: function () { return state.aggregate; },

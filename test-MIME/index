.grid-kpi   { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-m); }
.grid-2     { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-m); }

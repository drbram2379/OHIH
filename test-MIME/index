      return ["<strong>" + U.escapeHtml(s) + "</strong>"]
        .concat(vals.map(function (v) { return U.formatNumber(v); }))
        .concat(['<span style="color:' + color + '">' + U.formatSigned(delta) + "</span>"]);
    });
    root.appendChild(C.panel(C.dataTable(["Site", "2023", "2024", "2025", "2024\u21922025"], rows)));

    root.appendChild(C.sectionTitle("Driver Matrix \u2014 Category Composition by Site", "DE-4 C5.1"));
    var matrix = U.el("div", { class: "grid-3" });
    Object.keys(agg.by_site).forEach(function (s) {
      var cat = MIMEData.categories(s);
      var t = U.sumValues(cat);
      var box = C.panel("");
      box.insertAdjacentHTML("afterbegin", '<div class="badge-scope">' + U.escapeHtml(s) + "</div>");
      box.appendChild(C.barList(
        U.sortDesc(cat).map(function (e) {
          return {
            label: e.label.replace("Occupational ", ""),
            value: e.value,
            color: e.label.indexOf("Safety") !== -1 ? "var(--color-status-critical)" : "var(--color-brand-accent)"
          };
        }), { denominator: t }));
      matrix.appendChild(box);
    });
    root.appendChild(matrix);

    root.appendChild(C.panel(
      "<p>The largest contributors to enterprise volume are also the sites with the longest continuous reporting history. " +
      "Sites onboarded more recently show steep apparent growth curves that reflect coverage expansion. Any cross-site " +
      "severity comparison should control for reporting-history length before being read as a relative-risk signal; that " +
      "control requires a site-onboarding reference table which is not present in the supplied production data (recorded " +
      "as EXC-07 in P7).</p>", "Operational Interpretation"));
  }

  /* ================== P4 — Medical Incident Intelligence ================== */
  function renderP4(root, site) {
    root.innerHTML = "";
    var agg = MIMEData.aggregate();

    function distributionSection(title, question, map, note) {
      root.appendChild(C.sectionTitle(title, question));
      var total = U.sumValues(map);
      var p = C.panel("");
      p.appendChild(C.barList(U.sortDesc(map), { denominator: total }));
      if (note) { p.insertAdjacentHTML("beforeend", '<p class="panel__note">' + note + "</p>"); }
      root.appendChild(p);
    }

    distributionSection("Incident Type Distribution", "What kind of events are these?",
      MIMEData.types(site));

    distributionSection("Severity Criteria Distribution", "How severe are they?",
      MIMEData.criteria(site),
      "Records without a populated Incident_Criteria value are excluded here and quantified in P6 (DQ-02).");

    distributionSection("Medical Referral Transport Mode", "How were patients moved?",
      agg.by_transport,
      "Transport mode is populated for " + U.formatNumber(U.sumValues(agg.by_transport)) + " of " +
      U.formatNumber(agg.total_records) + " enterprise records (" +
      U.formatPercent(U.rate(U.sumValues(agg.by_transport), agg.total_records)) +
      "); the remainder are in-clinic or non-transported cases.");

    distributionSection("Medevac Execution Model", "Who executed the evacuation?",
      agg.by_executor);

    distributionSection("Medical Status at Point of Care", "What level of care was delivered?",
      agg.by_medstatus);
  }

  /* ================= P5 — Evidence & Case Traceability ==================== */
  function renderP5(root, site) {
    root.innerHTML = "";
    var agg = MIMEData.aggregate();

    root.appendChild(C.sectionTitle("Aggregate Evidence Ledger",
      "Enterprise and site level only \u2014 no patient or clinician detail is exposed"));

    var ledgerNote =
      "<p>Per DE-3A \u00A711 Information Granularity, patient names, case narratives and clinician identities are " +
      "<strong>excluded</strong> from this executive compilation on every page. The ledger below traces each headline " +
      "figure to its exact source aggregation so any number on this dashboard can be independently reproduced from the " +
      "certified worksheet.</p>";

    var rows = MIMEKpi.REGISTRY.map(function (kpi) {
      var r = MIMEKpi.resolve(kpi.id, site);
      return [
        "<strong>" + U.escapeHtml(r.name) + "</strong>",
        '<span class="tag">' + r.id + "</span>",
        '<span class="tag">' + MIME_CONFIG.PRIMARY_WORKSHEET + "</span>",
        '<span class="tag">' + U.escapeHtml(r.formula) + "</span>",
        r.display
      ];
    });

    var ledger = C.panel("");
    ledger.insertAdjacentHTML("afterbegin", ledgerNote);
    ledger.appendChild(C.dataTable(
      ["KPI", "KPI ID", "Source Worksheet", "Aggregation (as implemented)", "Current Value"], rows));
    root.appendChild(ledger);

    root.appendChild(C.sectionTitle("Site \u00D7 Year Drill-through", "DE-4 C6.5 Drill-through Panel"));
    var drill = Object.keys(agg.by_site_year)
      .map(function (k) { return { key: k, value: agg.by_site_year[k] }; })
      .sort(function (a, b) { return b.value - a.value; })
      .map(function (e) {
        var parts = e.key.split("|");
        var yearCell = parts[1] === "1899"
          ? '<span class="tag">Unresolvable date \u2014 see DQ-01</span>'
          : U.escapeHtml(parts[1]);
        return [U.escapeHtml(parts[0]), yearCell, U.formatNumber(e.value)];
      });
    root.appendChild(C.panel(C.dataTable(["Site", "Reporting Year", "Incident Records"], drill)));
  }

  /* ================== P6 — Governance & Data Quality ====================== */
  function renderP6(root) {
    root.innerHTML = "";
    var agg = MIMEData.aggregate();
    var invalidDates = agg.by_year["1899"] || 0;
    var v = MIMEConnector.getValidation();

    root.appendChild(C.sectionTitle("Data Completeness", "Can I trust these numbers?"));
    var grid = U.el("div", { class: "grid-kpi" });
    function completeness(label, populated, field) {
      var r = U.rate(populated, agg.total_records);
      var status = r === null ? "na" : r >= 95 ? "good" : r >= 70 ? "watch" : "action";
      grid.appendChild(C.kpiCard({
        label: label, value: U.formatPercent(r), unit: "of " + U.formatNumber(agg.total_records) + " records",
        status: status, source: field
      }));
    }
    completeness("Site Attribution Coverage", agg.total_records - agg.null_site, "Site_Code");
    completeness("Severity Criteria Coverage", agg.total_records - agg.null_criteria, "Incident_Criteria");
    completeness("Fitness Determination Coverage", agg.total_records - agg.null_fitness, "Fitness_Status");
    completeness("Resolvable Incident Date", agg.total_records - invalidDates, "Incident_date");
    root.appendChild(grid);

    root.appendChild(C.sectionTitle("Data Quality Findings", "Observed during compilation"));
    root.appendChild(C.panel(
      C.exception("DQ-01",
        "<strong>" + U.formatNumber(invalidDates) + " records (" +
        U.formatPercent(U.rate(invalidDates, agg.total_records)) + ")</strong> carry an unresolvable Incident_date " +
        "(parsing to the spreadsheet epoch, indicating a blank or malformed source cell). These are excluded from all " +
        "year-trend charts and surfaced explicitly rather than silently dropped.") +
      C.exception("DQ-02",
        "<strong>" + U.formatNumber(agg.null_criteria) + " records (" +
        U.formatPercent(U.rate(agg.null_criteria, agg.total_records)) + ")</strong> lack a populated Incident_Criteria " +
        "value. These concentrate within safety-classified events whose specific severity criterion was not carried into " +
        "the production feed. Domain A severity KPIs should therefore be read as a <strong>floor estimate</strong>, not a " +
        "complete census, until the gap is closed upstream.") +
      C.exception("DQ-03",
        "<strong>" + U.formatNumber(agg.null_fitness) + " records (" +
        U.formatPercent(U.rate(agg.null_fitness, agg.total_records)) + ")</strong> carry no Fitness_Status determination, " +
        "concentrated in cases handled without a formal fitness assessment logged in this feed.") +
      C.exception("DQ-04",
        "Site onboarding into the reporting system is <strong>staggered</strong>. Raw year-over-year enterprise totals " +
        "therefore conflate reporting-coverage growth with genuine incident-rate change. Every narrative on this dashboard " +
        "that references volume movement carries this caveat explicitly."),
      "Findings Register"));

    root.appendChild(C.sectionTitle("Runtime & Governance Register"));
    root.appendChild(C.panel(
      C.govRow("Framework Authority", "BDSE Framework v2.1 (Frozen)") +
      C.govRow("Release Candidate", "RC-01 \u2192 RC-09 (Certified)") +
      C.govRow("Production Compiler", "Claude \u2014 Implementation Authority Only") +
      C.govRow("Engineering Redesign Performed", "None") +
      C.govRow("Authoritative Workbook", "MIME.xlsx") +
      C.govRow("Bound Worksheet", '<span class="tag">' + MIME_CONFIG.PRIMARY_WORKSHEET + "</span>") +
      C.govRow("Certified Worksheet Inventory", MIME_CONFIG.WORKSHEET_REGISTER.length + " governed worksheets preserved") +
      C.govRow("Live Source Spreadsheet ID", '<span class="tag">' + MIME_CONFIG.SPREADSHEET_ID + "</span>") +
      C.govRow("Spreadsheet Accessible", v.spreadsheetAccessible ? "Yes" : "No") +
      C.govRow("Worksheet Available", v.worksheetAvailable ? "Yes" : "No") +
      C.govRow("Required Columns Present", v.requiredColumnsPresent ? "Yes" : "Not verified") +
      C.govRow("Runtime Data Mode", '<span class="tag">' + v.mode + "</span>") +
      C.govRow("Connector Detail", U.escapeHtml(v.detail || "\u2014")) +
      C.govRow("Records in Scope", U.formatNumber(agg.total_records) + " of " +
               U.formatNumber(agg.total_raw_rows) + " feed rows"),
      "Governance Register"));
  }

  /* ============ P7 — Executive References & Methodology =================== */
  function renderP7(root) {
    root.innerHTML = "";

    root.appendChild(C.sectionTitle("KPI Dictionary \u2014 Implemented in this Compilation"));
    var rows = MIMEKpi.REGISTRY.map(function (k) {
      return [
        "<strong>" + U.escapeHtml(k.name) + "</strong>",
        '<span class="tag">' + k.id + "</span>",
        '<span class="tag">Domain ' + k.domain + "</span>",
        U.escapeHtml(k.formula),
        U.escapeHtml(k.unit)
      ];
    });
    root.appendChild(C.panel(C.dataTable(["KPI", "KPI ID", "Domain", "Formula (as implemented)", "Unit"], rows)));

    root.appendChild(C.sectionTitle("Certified Worksheet Register", "RC-06A \u00A74"));
    var wsRows = MIME_CONFIG.WORKSHEET_REGISTER.map(function (w) {
      return [
        '<span class="tag">' + U.escapeHtml(w.name) + "</span>",
        U.escapeHtml(w.classification),
        w.status,
        w.runtimeBound ? "<strong>Bound</strong>" : "Reference only"
      ];
    });
    root.appendChild(C.panel(C.dataTable(["Worksheet", "Classification", "Status", "Runtime Binding"], wsRows)));

    root.appendChild(C.sectionTitle("Implementation Exception Report",
      "RC-06 \u00A714 \u2014 compilation stopped rather than inventing engineering"));
    root.appendChild(C.panel(
      C.exception("EXC-01 \u00B7 Domain A",
        "<strong>MIFR, MISI, SMCR, EMSS</strong> require either an exposure-hours / workforce-headcount denominator or a " +
        "governed composite weighting methodology from the Executive KPI Model. Neither the denominator nor the numeric EKM " +
        "weighting coefficients were located in the supplied attachment set. <strong>Not implemented.</strong> Count-based " +
        "measures are shown instead, explicitly labelled as counts rather than rates.") +
      C.exception("EXC-02 \u00B7 Domain D",
        "<strong>Regulatory Compliance Rate, Audit Finding Closure Rate, Overdue Compliance Action Rate, Regulatory " +
        "Inspection Readiness, Regulatory Finding Severity Index, Compliance Assurance Index</strong> require a compliance " +
        "and audit register (CAPA register, inspection findings, permit and licence registers). No such worksheet exists in " +
        "MIME.xlsx. <strong>Domain D is entirely absent from this build.</strong>") +
      C.exception("EXC-03 \u00B7 Domain F",
        "<strong>RTW duration KPIs</strong> depend on a field present only in per-site engineering worksheets and not " +
        "carried into the certified production feed. <strong>Not implemented.</strong>") +
      C.exception("EXC-04 \u00B7 Domain G",
        "<strong>WHPI and BCHI</strong> are composite indices whose weighting methodology is deferred by the KPI Dictionary " +
        "to the Executive KPI Model. No numeric weights were located. <strong>Not implemented.</strong>") +
      C.exception("EXC-05 \u00B7 Cross-cutting",
        "<strong>Numeric benchmark thresholds</strong> for the implemented KPIs were not located in a KPI Threshold " +
        "Register. All implemented KPIs report a Not Available benchmark status rather than an invented evaluation.") +
      C.exception("EXC-06 \u00B7 Domain B / C",
        "<strong>Medical cost, length-of-stay cost and case-management cost KPIs</strong> require a finance data source " +
        "absent from the supplied workbook. <strong>Not implemented.</strong>") +
      C.exception("EXC-07 \u00B7 Cross-cutting",
        "<strong>Site onboarding reference table</strong> (first reporting date per site) is not present in the supplied " +
        "data. Without it, reporting-coverage growth cannot be separated from genuine incident-rate change, so no " +
        "normalised cross-site risk comparison is offered."),
      "Exception Register"));

    root.appendChild(C.sectionTitle("Compiler Certification", "RC-07 \u00A718"));
    root.appendChild(C.panel(
      C.govRow("Only approved Release Candidate documents used", "Confirmed") +
      C.govRow("Engineering decisions introduced during compilation", "None") +
      C.govRow("KPI definitions, formulae or thresholds modified", "None") +
      C.govRow("Dashboard pages added, removed or resequenced", "None \u2014 P1\u2013P7 preserved") +
      C.govRow("Business terminology renamed", "None \u2014 worksheet and field names preserved verbatim") +
      C.govRow("Unresolved ambiguity handling", "Reported as exceptions (EXC-01 \u2192 EXC-07), never inferred") +
      C.govRow("Production readiness", "Ready for the KPI scope supported by the supplied data source"),
      "Certification Statement"));
  }

  var RENDERERS = { P1: renderP1, P2: renderP2, P3: renderP3, P4: renderP4, P5: renderP5, P6: renderP6, P7: renderP7 };

  function render(pageId, root, site) {
    return MIMEErrors.guard("page:" + pageId, function () {
      return RENDERERS[pageId](root, site);
    }, root);
  }

  return { INVENTORY: INVENTORY, render: render };
})();

/* =============================================================================
 * Export Module
 * Authority : RC-05 §6 (Export Module mandatory), RC-06 §6
 * Rule      : Exported values are the governed values rendered on screen. The
 *             export never recomputes or reinterprets a KPI.
 * ========================================================================== */
var MIMEExport = (function () {
  "use strict";

  function csvEscape(value) {
    return '"' + String(value === null || value === undefined ? "" : value).replace(/"/g, '""') + '"';
  }

  function buildRows(site) {
    var agg = MIMEData.aggregate();
    var rows = [];

    if (MIME_CONFIG.EXPORT_POLICY.includeGovernanceHeader) {
      rows.push(["BDSE Framework v2.1 - MIME Executive Dashboard Export"]);
      rows.push(["Engineering Authority", "Release Candidate RC-01 to RC-09 (Frozen)"]);
      rows.push(["Authoritative Workbook", "MIME.xlsx"]);
      rows.push(["Bound Worksheet", MIME_CONFIG.PRIMARY_WORKSHEET]);
      rows.push(["Runtime Data Mode", MIMEData.source()]);
      rows.push(["Scope", site === "ALL" ? "Enterprise (all sites)" : site]);
      rows.push(["Exported", new Date().toISOString()]);
      rows.push([]);
    }

    rows.push(["Section", "Item", "Value", "Unit"]);

    MIMEKpi.REGISTRY.forEach(function (kpi) {
      var resolved = MIMEKpi.resolve(kpi.id, site);
      rows.push(["KPI", resolved.name + " (" + resolved.id + ")", resolved.display, resolved.unit]);
    });

    rows.push([]);
    rows.push(["Site Distribution", "Site_Code", "Incident Count", "records"]);
    Object.keys(agg.by_site).forEach(function (k) { rows.push(["Site Distribution", k, agg.by_site[k], "records"]); });

    rows.push([]);
    rows.push(["Severity Criteria", "Incident_Criteria", "Count", "records"]);
    Object.keys(agg.by_criteria).forEach(function (k) { rows.push(["Severity Criteria", k, agg.by_criteria[k], "records"]); });

    rows.push([]);
    rows.push(["Incident Type", "Incident_Type", "Count", "records"]);
    Object.keys(agg.by_type).forEach(function (k) { rows.push(["Incident Type", k, agg.by_type[k], "records"]); });

    rows.push([]);
    rows.push(["Fitness Status", "Fitness_Status", "Count", "records"]);
    Object.keys(agg.by_fitness).forEach(function (k) { rows.push(["Fitness Status", k, agg.by_fitness[k], "records"]); });

    return rows;
  }

  function toCsv(site) {
    return buildRows(site).map(function (r) {
      return r.map(csvEscape).join(",");
    }).join("\r\n");
  }

  function download(site) {
    try {
      if (!MIME_CONFIG.FEATURE_SWITCHES.EXPORT_MODULE) { return false; }
      var blob = new Blob(["\uFEFF" + toCsv(site)], { type: "text/csv;charset=utf-8;" });
      var url = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = url;
      a.download = "MIME_Executive_Dashboard_" + (site === "ALL" ? "Enterprise" : site) + "_" +
                   new Date().toISOString().slice(0, 10) + ".csv";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      return true;
    } catch (err) {
      MIMEErrors.record("export", err);
      return false;
    }
  }

  return { download: download, toCsv: toCsv };
})();

/* =============================================================================
 * Print Module
 * Authority : RC-05 §6 (Print Module mandatory), DE-5F (print/PDF viewport)
 * Rule      : Print reveals every engineered page in governed sequence P1->P7.
 *             Print must not alter executive reading order (DE-7C §9).
 * ========================================================================== */
var MIMEPrint = (function () {
  "use strict";

  function execute() {
    try {
      if (!MIME_CONFIG.FEATURE_SWITCHES.PRINT_MODULE) { return false; }
      document.body.setAttribute("data-print-scope", "ALL_PAGES");
      window.print();
      return true;
    } catch (err) {
      MIMEErrors.record("print", err);
      return false;
    } finally {
      document.body.removeAttribute("data-print-scope");
    }
  }

  return { execute: execute };
})();

/* =============================================================================
 * Application Controller
 * Authority : RC-08 §6 Deployment Sequence (Phases 1-5)
 *             RC-08 §7 Runtime Initialization Requirements
 * Sequence  : Package verification -> Runtime initialization -> Data
 *             connection -> Runtime validation -> Operational activation.
 * ========================================================================== */
var MIMEApp = (function () {
  "use strict";

  var U = MIMEUtils;

  var runtime = {
    activePage: "P1",
    site: "ALL",
    validation: {
      configurationLoaded: false,
      dataLoaded: false,
      worksheetResolved: false,
      requiredColumnsPresent: false,
      kpiCalculationSucceeded: false,
      chartsRendered: false,
      filtersFunctional: false,
      navigationFunctional: false,
      exportAvailable: false,
      printAvailable: false,
      responsiveLayoutActive: false
    }
  };

  /* ---- RC-08 Phase 1: Package verification ------------------------------ */
  function verifyPackage() {
    var required = ["MIME_CONFIG", "MIME_FIELDS", "MIME_SNAPSHOT", "MIMEUtils",
                    "MIMEErrors", "MIMEData", "MIMEKpi", "MIMEComponents",
                    "MIMEPages", "MIMEConnector", "MIMEExport", "MIMEPrint"];
    var missing = required.filter(function (name) { return typeof window[name] === "undefined"; });
    if (missing.length) {
      throw new Error("Production package incomplete. Missing modules: " + missing.join(", "));
    }
    runtime.validation.configurationLoaded = true;
  }

  /* ---- RC-08 Phase 2: Runtime initialization ---------------------------- */
  function buildNavigation() {
    var nav = document.getElementById("pageNav");
    nav.innerHTML = "";
    MIMEPages.INVENTORY.forEach(function (page, index) {
      var btn = U.el("button", {
        class: "nav-item" + (index === 0 ? " is-active" : ""),
        type: "button",
        "data-page": page.id,
        "aria-label": page.id + " " + page.name
      });
      btn.insertAdjacentHTML("beforeend", '<span class="nav-item__id">' + page.id + "</span>");
      btn.appendChild(document.createTextNode(page.name));
      btn.addEventListener("click", function () { activatePage(page.id); });
      nav.appendChild(btn);
    });
    runtime.validation.navigationFunctional = true;
  }

  function buildPageContainers() {
    var content = document.getElementById("pageContent");
    content.innerHTML = "";
    MIMEPages.INVENTORY.forEach(function (page, index) {
      content.appendChild(U.el("section", {
        class: "page" + (index === 0 ? " is-active" : ""),
        id: page.id,
        role: "tabpanel",
        "aria-label": page.name
      }));
    });
  }

  function buildFilters() {
    var agg = MIMEData.aggregate();
    var siteSelect = document.getElementById("filterSite");
    siteSelect.innerHTML = '<option value="ALL">All Sites (Enterprise)</option>';
    Object.keys(agg.by_site).sort().forEach(function (s) {
      siteSelect.appendChild(U.el("option", { value: s }, s));
    });
    siteSelect.addEventListener("change", function () {
      runtime.site = siteSelect.value;
      renderAll();
    });
    runtime.validation.filtersFunctional = true;
  }

  function bindActions() {
    document.getElementById("btnExport").addEventListener("click", function () {
      var ok = MIMEExport.download(runtime.site);
      runtime.validation.exportAvailable = ok;
      if (!ok) { notify("Export could not be completed. See runtime log."); }
    });
    document.getElementById("btnPrint").addEventListener("click", function () {
      runtime.validation.printAvailable = MIMEPrint.execute();
    });
    document.getElementById("btnRefresh").addEventListener("click", function () {
      connectAndRender(true);
    });
  }

  function activatePage(pageId) {
    runtime.activePage = pageId;
    Array.prototype.forEach.call(document.querySelectorAll(".nav-item"), function (b) {
      b.classList.toggle("is-active", b.getAttribute("data-page") === pageId);
    });
    Array.prototype.forEach.call(document.querySelectorAll(".page"), function (p) {
      p.classList.toggle("is-active", p.id === pageId);
    });
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function notify(message) {
    var bar = document.getElementById("runtimeNotice");
    bar.textContent = message;
    bar.hidden = false;
  }

  /* ---- Source indicator -------------------------------------------------- */
  function updateSourceIndicator() {
    var v = MIMEConnector.getValidation();
    var dot = document.getElementById("sourceDot");
    var label = document.getElementById("sourceLabel");

    if (v.mode === "LIVE") {
      dot.className = "status-dot status-dot--live";
      label.textContent = "Live Google Sheets source \u00B7 " + U.formatNumber(v.rowCount) + " rows";
    } else {
      dot.className = "status-dot status-dot--fallback";
      label.textContent = "Certified snapshot (RC-06A baseline) \u00B7 live source unavailable";
      label.title = v.detail || "";
    }
  }

  /* ---- RC-08 Phases 3-4: connect, validate, render ---------------------- */
  function connectAndRender(isRefresh) {
    document.getElementById("appShell").classList.add("is-loading");
    return MIMEConnector.connect().then(function (result) {
      if (result.ok) {
        try {
          MIMEData.loadLive(result.table);
          runtime.validation.worksheetResolved = true;
          runtime.validation.requiredColumnsPresent = true;
        } catch (err) {
          MIMEErrors.record("binding", err, "WARN");
          MIMEData.loadSnapshot();
        }
      } else {
        MIMEData.loadSnapshot();
      }
      runtime.validation.dataLoaded = !!MIMEData.aggregate();
      updateSourceIndicator();
      if (isRefresh) { buildFilters(); }
      renderAll();
      document.getElementById("appShell").classList.remove("is-loading");
    });
  }

  function renderAll() {
    MIMEPages.INVENTORY.forEach(function (page) {
      MIMEPages.render(page.id, document.getElementById(page.id), runtime.site);
    });
    runtime.validation.kpiCalculationSucceeded = !MIMEErrors.hasErrors();
    runtime.validation.chartsRendered = !!document.querySelector("svg.trend");
    runtime.validation.responsiveLayoutActive = !!window.matchMedia;
    document.getElementById("dataAsOf").textContent =
      new Date().toISOString().slice(0, 10);
  }

  /* ---- Boot -------------------------------------------------------------- */
  function boot() {
    try {
      verifyPackage();
      MIMEData.loadSnapshot();
      buildPageContainers();
      buildNavigation();
      buildFilters();
      bindActions();
      document.getElementById("buildVersion").textContent = MIME_CONFIG.APPLICATION.BUILD_VERSION;
      document.getElementById("compileStamp").textContent = new Date().toISOString();
      renderAll();
      connectAndRender(false);
    } catch (err) {
      MIMEErrors.record("boot", err);
      document.getElementById("pageContent").innerHTML =
        '<div class="exception exception--error"><span class="exception__id">STARTUP</span>' +
        "The dashboard could not start because the production package is incomplete. " +
        "Verify that all module files listed in the technical documentation are deployed together.</div>";
    }
  }

  function getValidationReport() {
    return { runtime: runtime.validation, connector: MIMEConnector.getValidation(), errors: MIMEErrors.getLog() };
  }

  return { boot: boot, getValidationReport: getValidationReport };
})();

document.addEventListener("DOMContentLoaded", MIMEApp.boot);

</script>

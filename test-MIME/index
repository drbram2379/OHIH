/* =============================================================================
 * KPI Engine
 * Authority : Dashboard KPI Dictionary (DKD-A / DKD-B / DKD-E / DKD-F)
 *             RC-03 §6 KPI Traceability (definitions, formulae, thresholds,
 *             units and aggregation rules SHALL NOT be modified)
 *
 * IMPLEMENTATION NOTE (RC-06 §14 Missing Information Rule)
 * -------------------------------------------------------
 * Numeric Target / Watch / Action Required / Critical threshold VALUES were
 * not located in the supplied Release Candidate attachment set. Consequently
 * every KPI below returns benchmarkStatus "NA" rather than an invented
 * evaluation. The registry structure is threshold-ready: when the KPI
 * Threshold Register is issued, populate `thresholds` and the benchmark
 * status resolves automatically with no other code change.
 * ========================================================================== */
var MIMEKpi = (function () {
  "use strict";

  var U = MIMEUtils;

  /* Benchmark evaluation is presentation of a governed evaluation only.
     The component never independently determines compliance (DE-4 C3.1). */
  function evaluate(value, thresholds, direction) {
    if (!thresholds || value === null || value === undefined) { return "na"; }
    var lowerIsBetter = direction === "LOWER_IS_BETTER";
    function breach(limit) { return lowerIsBetter ? value >= limit : value <= limit; }
    if (thresholds.critical !== undefined && breach(thresholds.critical)) { return "critical"; }
    if (thresholds.action   !== undefined && breach(thresholds.action))   { return "action"; }
    if (thresholds.watch    !== undefined && breach(thresholds.watch))    { return "watch"; }
    return "good";
  }

  var REGISTRY = [
    {
      id: "DKD-A-TOTAL", name: "Total Classified Incidents", domain: "A",
      unit: "records", direction: "LOWER_IS_BETTER", thresholds: null,
      formula: "COUNT(Incident_ID) WHERE Incident_ID IS NOT NULL",
      compute: function (site) {
        return site === "ALL"
          ? U.sumValues(MIMEData.aggregate().by_site)
          : (MIMEData.aggregate().by_site[site] || 0);
      },
      format: function (v) { return U.formatNumber(v); }
    },
    {
      id: "DKD-A-FATAL", name: "Fatalities on Record", domain: "A",
      unit: "cases", direction: "LOWER_IS_BETTER", thresholds: { critical: 1 },
      formula: "COUNT WHERE Incident_Criteria IN ('FATALITY','Illness Fatality')",
      compute: function (site) {
        var c = MIMEData.criteria(site);
        return (c["FATALITY"] || 0) + (c["Illness Fatality"] || 0);
      },
      format: function (v) { return U.formatNumber(v); }
    },
    {
      id: "DKD-A-LTI", name: "Lost Time Incidents (LTI)", domain: "A",
      unit: "cases", direction: "LOWER_IS_BETTER", thresholds: null,
      formula: "COUNT WHERE Incident_Criteria = 'LTI'",
      compute: function (site) { return MIMEData.criteria(site)["LTI"] || 0; },
      format: function (v) { return U.formatNumber(v); }
    },
    {
      id: "DKD-A-OIIR", name: "Occupational Illness Share", domain: "A",
      unit: "% of classified category records", direction: "LOWER_IS_BETTER", thresholds: null,
      formula: "Occupational Health Incident / (Health + Safety Incidents) x 100",
      compute: function (site) {
        var c = MIMEData.categories(site);
        var health = c["Occupational Health Incident"] || 0;
        var safety = c["Occupational Safety Incident"] || 0;
        return U.rate(health, health + safety);
      },
      format: function (v) { return U.formatPercent(v); }
    },
    {
      id: "DKD-B-REF", name: "Referral Rate", domain: "B",
      unit: "% of classified incident-type records", direction: "LOWER_IS_BETTER", thresholds: null,
      formula: "COUNT(Incident_Type='Referral') / COUNT(Incident_Type) x 100",
      compute: function (site) {
        var t = MIMEData.types(site);
        return U.rate(t["Referral"] || 0, U.sumValues(t));
      },
      format: function (v) { return U.formatPercent(v); }
    },
    {
      id: "DKD-B-MEDEVAC", name: "Medevac Utilisation Rate", domain: "B",
      unit: "% of classified incident-type records", direction: "LOWER_IS_BETTER", thresholds: null,
      formula: "COUNT(Incident_Type='Medevac') / COUNT(Incident_Type) x 100",
      compute: function (site) {
        var t = MIMEData.types(site);
        return U.rate(t["Medevac"] || 0, U.sumValues(t));
      },
      format: function (v) { return U.formatPercent(v, 2); }
    },
    {
      id: "DKD-B-SICK", name: "Sick Leave Share", domain: "B",
      unit: "% of classified incident-type records", direction: "LOWER_IS_BETTER", thresholds: null,
      formula: "COUNT(Incident_Type='Sick Leave') / COUNT(Incident_Type) x 100",
      compute: function (site) {
        var t = MIMEData.types(site);
        return U.rate(t["Sick Leave"] || 0, U.sumValues(t));
      },
      format: function (v) { return U.formatPercent(v); }
    },
    {
      id: "DKD-E-FIT", name: "Fit-for-Work Determination Rate", domain: "E",
      unit: "% of determined records", direction: "HIGHER_IS_BETTER", thresholds: null,
      formula: "COUNT(Fitness_Status='Fit') / COUNT(Fitness_Status determined) x 100",
      compute: function (site) {
        var f = MIMEData.fitness(site);
        return U.rate(f["Fit"] || 0, U.sumValues(f));
      },
      format: function (v) { return U.formatPercent(v); }
    },
    {
      id: "DKD-E-UNFIT", name: "Temporary / Permanent Unfit Rate", domain: "E",
      unit: "% of determined records", direction: "LOWER_IS_BETTER", thresholds: null,
      formula: "COUNT(Fitness_Status IN ('Temporary Unfit','Unfit')) / COUNT(determined) x 100",
      compute: function (site) {
        var f = MIMEData.fitness(site);
        return U.rate((f["Temporary Unfit"] || 0) + (f["Unfit"] || 0), U.sumValues(f));
      },
      format: function (v) { return U.formatPercent(v, 2); }
    },
    {
      id: "DKD-F-RTW", name: "RTW Programme Engagement Rate", domain: "F",
      unit: "% of flagged records (enterprise scope)", direction: "HIGHER_IS_BETTER", thresholds: null,
      formula: "COUNT(Is_Medical_Rehab_Flag=1) / COUNT(Is_Medical_Rehab_Flag) x 100",
      compute: function () {
        var r = MIMEData.aggregate().rehab_flag;
        return U.rate(r["1"] || 0, U.sumValues(r));
      },
      format: function (v) { return U.formatPercent(v); }
    }
  ];

  function byId(id) {
    return REGISTRY.filter(function (k) { return k.id === id; })[0];
  }

  function resolve(id, site) {
    var kpi = byId(id);
    if (!kpi) { throw new Error("Unknown KPI identifier: " + id); }
    var value = kpi.compute(site);
    return {
      id: kpi.id,
      name: kpi.name,
      domain: kpi.domain,
      unit: kpi.unit,
      formula: kpi.formula,
      raw: value,
      display: kpi.format(value),
      benchmarkStatus: evaluate(value, kpi.thresholds, kpi.direction)
    };
  }

  return { REGISTRY: REGISTRY, resolve: resolve, byId: byId };
})();

/* =============================================================================
 * Production Component Library
 * Authority : DE-4 Dashboard Component Engineering (C1-C10)
 * Rule      : Each engineered component becomes exactly one production
 *             component (RC-07 §9). Components render governed values; they
 *             never compute benchmark compliance themselves (DE-4 C3.1).
 * ========================================================================== */
var MIMEComponents = (function () {
  "use strict";

  var U = MIMEUtils;

  var STATUS_LABEL = {
    good: "Good", watch: "Watch", action: "Action Required",
    critical: "Critical", na: "Not Available"
  };

  /* --- C3.1 Benchmark Status Indicator ---------------------------------- */
  function statusChip(level) {
    return '<span class="status-chip status-chip--' + level + '">' +
           STATUS_LABEL[level] + "</span>";
  }

  /* --- C2.1 Executive KPI Card ------------------------------------------ */
  function kpiCard(opts) {
    var card = U.el("div", { class: "kpi-card" });
    var label = U.el("div", { class: "kpi-card__label" });
    label.appendChild(document.createTextNode(opts.label));
    label.insertAdjacentHTML("beforeend", statusChip(opts.status || "na"));
    card.appendChild(label);

    var value = U.el("div", { class: "kpi-card__value" }, opts.value);
    if (opts.valueColor) { value.style.color = opts.valueColor; }
    card.appendChild(value);
    card.appendChild(U.el("div", { class: "kpi-card__unit" }, opts.unit || ""));

    if (opts.delta) {
      card.appendChild(U.el("div", { class: "kpi-card__delta kpi-card__delta--" + opts.delta.dir },
        opts.delta.text));
    }
    if (opts.source) {
      card.appendChild(U.el("div", { class: "kpi-card__source" }, opts.source));
    }
    return card;
  }

  /* --- C7.x Executive Verdict ------------------------------------------- */
  function verdict(opts) {
    var wrap = U.el("div", { class: "verdict" });
    var badge = U.el("div", { class: "verdict__badge" }, opts.glyph);
    badge.style.background = opts.color;
    wrap.appendChild(badge);
    var body = U.el("div", { class: "verdict__body" });
    body.appendChild(U.el("h3", {}, opts.headline));
    body.appendChild(U.el("p", { html: opts.statement }));
    body.appendChild(U.el("div", { class: "verdict__cite" }, opts.citation));
    wrap.appendChild(body);
    return wrap;
  }

  /* --- C5.x Comparative Analysis (bar list) ----------------------------- */
  function barList(entries, opts) {
    opts = opts || {};
    var frag = document.createDocumentFragment();
    var max = Math.max.apply(null, entries.map(function (e) { return e.value; }).concat([1]));
    entries.forEach(function (entry) {
      var row = U.el("div", { class: "bar-row" });
      row.appendChild(U.el("div", { class: "bar-row__name", title: entry.label }, entry.label));
      var track = U.el("div", { class: "bar-track" });
      var fill = U.el("div", { class: "bar-fill" });
      fill.style.width = Math.max(2, (entry.value / max) * 100) + "%";
      if (entry.color) { fill.style.background = entry.color; }
      track.appendChild(fill);
      row.appendChild(track);
      var display = opts.denominator
        ? U.formatPercent(U.rate(entry.value, opts.denominator))
        : U.formatNumber(entry.value);
      row.appendChild(U.el("div", { class: "bar-row__value" }, display));
      frag.appendChild(row);
    });
    return frag;
  }

  /* --- C4.1 Trend Line --------------------------------------------------- */
  function trendLine(pairs, opts) {
    opts = opts || {};
    var w = opts.width || 760, h = opts.height || 180, pad = 32;
    var values = pairs.map(function (p) { return p[1]; });
    var max = Math.max.apply(null, values.concat([1]));
    var stepX = (w - pad * 2) / Math.max(1, pairs.length - 1);
    function y(v) { return h - pad - (v / max) * (h - pad * 2); }

    var path = "", points = "", labels = "";
    pairs.forEach(function (p, i) {
      var x = pad + i * stepX, yy = y(p[1]);
      path += (i === 0 ? "M" : "L") + x + "," + yy + " ";
      points += '<circle cx="' + x + '" cy="' + yy + '" r="3.5" fill="var(--color-brand-accent)"><title>' +
                U.escapeHtml(p[0]) + ": " + U.formatNumber(p[1]) + "</title></circle>";
      labels += '<text x="' + x + '" y="' + (h - 10) + '" text-anchor="middle">' + U.escapeHtml(p[0]) + "</text>";
      labels += '<text x="' + x + '" y="' + (yy - 10) + '" text-anchor="middle" fill="var(--color-text-secondary)">' +
                U.formatNumber(p[1]) + "</text>";
    });

    return '<svg class="trend" viewBox="0 0 ' + w + " " + h + '" width="100%" style="max-width:' + w + 'px" ' +
           'role="img" aria-label="' + U.escapeHtml(opts.ariaLabel || "Trend chart") + '">' +
           '<line x1="' + pad + '" y1="' + (h - pad) + '" x2="' + (w - 10) + '" y2="' + (h - pad) +
           '" stroke="var(--color-border)"/>' +
           '<path d="' + path + '" fill="none" stroke="var(--color-brand-accent)" stroke-width="2.4"/>' +
           points + labels + "</svg>";
  }

  /* --- C6.4 Audit Table -------------------------------------------------- */
  function dataTable(headers, rows) {
    var scroll = U.el("div", { class: "table-scroll" });
    var table = U.el("table", { class: "data-table" });
    table.innerHTML =
      "<thead><tr>" + headers.map(function (h) { return "<th>" + U.escapeHtml(h) + "</th>"; }).join("") + "</tr></thead>" +
      "<tbody>" + rows.map(function (r) {
        return "<tr>" + r.map(function (c) { return "<td>" + c + "</td>"; }).join("") + "</tr>";
      }).join("") + "</tbody>";
    scroll.appendChild(table);
    return scroll;
  }

  /* --- C9.x Governance row ----------------------------------------------- */
  function govRow(key, value) {
    return '<div class="gov-row"><span class="gov-row__key">' + U.escapeHtml(key) +
           '</span><span class="gov-row__value">' + value + "</span></div>";
  }

  /* --- Section heading (DE-5D zone marker) ------------------------------- */
  function sectionTitle(title, question) {
    var wrap = U.el("div", { class: "section-title" });
    wrap.appendChild(U.el("h2", {}, title));
    if (question) { wrap.appendChild(U.el("span", { class: "section-title__q" }, question)); }
    return wrap;
  }

  function panel(children, heading) {
    var p = U.el("div", { class: "panel" });
    if (heading) { p.appendChild(U.el("h4", {}, heading)); }
    (Array.isArray(children) ? children : [children]).forEach(function (c) {
      if (typeof c === "string") { p.insertAdjacentHTML("beforeend", c); }
      else if (c) { p.appendChild(c); }
    });
    return p;
  }

  function exception(id, text) {
    return '<div class="exception"><span class="exception__id">' + U.escapeHtml(id) + "</span>" + text + "</div>";
  }

  return {
    statusChip: statusChip, kpiCard: kpiCard, verdict: verdict, barList: barList,
    trendLine: trendLine, dataTable: dataTable, govRow: govRow,
    sectionTitle: sectionTitle, panel: panel, exception: exception
  };
})();


/* =============================================================================
 * Error Handling Module
 * Authority : RC-06 §13 Error Handling Specification
 * Rules     : errors avoid exposing sensitive implementation detail;
 *             application stability is preserved; diagnostic logging supported.
 * ========================================================================== */
var MIMEErrors = (function () {
  "use strict";

  var log = [];

  function record(scope, err, severity) {
    var entry = {
      timestamp: new Date().toISOString(),
      scope: scope,
      severity: severity || "ERROR",
      message: (err && err.message) ? err.message : String(err)
    };
    log.push(entry);
    if (MIME_CONFIG.FEATURE_SWITCHES.DIAGNOSTIC_LOG) {
      console[severity === "WARN" ? "warn" : "error"]("[MIME][" + scope + "]", entry.message);
    }
    return entry;
  }

  /* Wraps a render function so a single component failure never takes down
     the dashboard (RC-06 §13 "preserve application stability"). */
  function guard(scope, fn, fallbackNode) {
    try {
      return fn();
    } catch (err) {
      record(scope, err);
      if (fallbackNode) {
        fallbackNode.innerHTML =
          '<div class="exception exception--error"><span class="exception__id">RUNTIME</span>' +
          'This section could not be rendered. The certified data set is unaffected and other ' +
          'sections remain available. Diagnostic detail has been written to the runtime log.</div>';
      }
      return null;
    }
  }

  function getLog()  { return log.slice(); }
  function hasErrors() { return log.some(function (e) { return e.severity === "ERROR"; }); }

  return { record: record, guard: guard, getLog: getLog, hasErrors: hasErrors };
})();

/* =============================================================================
 * Utility Module
 * Authority : RC-06 §6 (mandatory utility module), §9 (isolate reusable
 *             functions). Contains no business logic and no KPI definitions.
 * ========================================================================== */
var MIMEUtils = (function () {
  "use strict";

  function formatNumber(value, decimals) {
    var d = decimals || 0;
    if (value === null || value === undefined || isNaN(value)) { return "n/a"; }
    return Number(value).toLocaleString("en-US", {
      minimumFractionDigits: d, maximumFractionDigits: d
    });
  }

  function formatPercent(value, decimals) {
    if (value === null || value === undefined || isNaN(value)) { return "n/a"; }
    return formatNumber(value, decimals === undefined ? 1 : decimals) + "%";
  }

  function formatSigned(value, decimals) {
    if (value === null || value === undefined || isNaN(value)) { return "n/a"; }
    return (value >= 0 ? "+" : "") + formatNumber(value, decimals === undefined ? 1 : decimals) + "%";
  }

  /* Guarded division — returns null rather than Infinity/NaN so callers can
     render an explicit "not available" state (RC-06 §11 validate before render) */
  function rate(numerator, denominator) {
    if (!denominator || denominator <= 0) { return null; }
    return (numerator / denominator) * 100;
  }

  function sumValues(obj) {
    if (!obj) { return 0; }
    return Object.keys(obj).reduce(function (acc, k) { return acc + obj[k]; }, 0);
  }

  function sortDesc(obj) {
    return Object.keys(obj || {})
      .map(function (k) { return { label: k, value: obj[k] }; })
      .sort(function (a, b) { return b.value - a.value; });
  }

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  function el(tag, attrs, children) {
    var node = document.createElement(tag);
    attrs = attrs || {};
    Object.keys(attrs).forEach(function (k) {
      if (k === "class") { node.className = attrs[k]; }
      else if (k === "html") { node.innerHTML = attrs[k]; }
      else { node.setAttribute(k, attrs[k]); }
    });
    if (children) {
      (Array.isArray(children) ? children : [children]).forEach(function (c) {
        if (c === null || c === undefined) { return; }
        node.appendChild(typeof c === "string" ? document.createTextNode(c) : c);
      });
    }
    return node;
  }

  return {
    formatNumber: formatNumber,
    formatPercent: formatPercent,
    formatSigned: formatSigned,
    rate: rate,
    sumValues: sumValues,
    sortDesc: sortDesc,
    escapeHtml: escapeHtml,
    el: el
  };
})();

/* =============================================================================
 * Runtime Data Connector
 * Authority : RC-06A §3 Production Data Architecture
 *             RC-08 §6 Phase 3 Data Connection / Phase 4 Runtime Validation
 * Behaviour : Connects to the certified Google Sheets production source.
 *             Validates spreadsheet accessibility, worksheet availability and
 *             required columns. On failure, applies ERROR_POLICY
 *             (FALLBACK_TO_CERTIFIED_SNAPSHOT) so the dashboard degrades
 *             gracefully rather than failing (RC-06 §13).
 * ========================================================================== */
var MIMEConnector = (function () {
  "use strict";

  var validation = {
    spreadsheetAccessible: false,
    worksheetAvailable: false,
    requiredColumnsPresent: false,
    rowCount: 0,
    mode: "PENDING",
    detail: ""
  };

  function fetchWithTimeout(url, timeoutMs) {
    return new Promise(function (resolve, reject) {
      var controller = new AbortController();
      var timer = setTimeout(function () {
        controller.abort();
        reject(new Error("Connection timed out after " + timeoutMs + "ms"));
      }, timeoutMs);

      fetch(url, { signal: controller.signal, mode: "cors" })
        .then(function (res) {
          clearTimeout(timer);
          if (!res.ok) { throw new Error("Source responded with HTTP " + res.status); }
          return res.text();
        })
        .then(resolve)
        .catch(function (err) { clearTimeout(timer); reject(err); });
    });
  }

  /* Google Visualization API wraps its JSON payload in a callback envelope. */
  function parseGvizPayload(text) {
    var match = text.match(/setResponse\(([\s\S]*)\)/);
    if (!match) { throw new Error("Unrecognised response format from data source"); }
    var parsed = JSON.parse(match[1]);
    if (parsed.status === "error") {
      var reason = (parsed.errors && parsed.errors[0] && parsed.errors[0].detailed_message) || "source returned an error";
      throw new Error(reason.replace(/<[^>]*>/g, ""));
    }
    if (!parsed.table) { throw new Error("No worksheet table returned"); }
    return parsed.table;
  }

  function validateColumns(table) {
    var labels = (table.cols || []).map(function (c) { return (c.label || "").trim(); });
    var missing = MIME_REQUIRED_COLUMNS.filter(function (required) {
      return labels.indexOf(required) === -1;
    });
    return { ok: missing.length === 0, missing: missing, labels: labels };
  }

  function attempt(attemptNumber) {
    var cfg = MIME_CONFIG;
    var url = cfg.GVIZ_ENDPOINT(cfg.SPREADSHEET_ID, cfg.PRIMARY_WORKSHEET);

    return fetchWithTimeout(url, cfg.TIMEOUT_POLICY)
      .then(function (text) {
        validation.spreadsheetAccessible = true;
        var table = parseGvizPayload(text);
        validation.worksheetAvailable = true;
        validation.rowCount = (table.rows || []).length;

        var colCheck = validateColumns(table);
        validation.requiredColumnsPresent = colCheck.ok;
        if (!colCheck.ok) {
          validation.detail = "Required columns absent from live worksheet: " + colCheck.missing.join(", ");
          validation.mode = "LIVE_SCHEMA_MISMATCH";
          MIMEErrors.record("connector", new Error(validation.detail), "WARN");
          return { ok: false, table: null };
        }

        validation.mode = "LIVE";
        validation.detail = "Live worksheet reachable and schema-conformant.";
        return { ok: true, table: table };
      })
      .catch(function (err) {
        if (attemptNumber < MIME_CONFIG.RETRY_POLICY.attempts) {
          return new Promise(function (resolve) {
            setTimeout(function () { resolve(attempt(attemptNumber + 1)); },
                       MIME_CONFIG.RETRY_POLICY.backoffMs);
          });
        }
        validation.mode = "SNAPSHOT_FALLBACK";
        validation.detail = err.message;
        MIMEErrors.record("connector", err, "WARN");
        return { ok: false, table: null };
      });
  }

  function connect() {
    if (!MIME_CONFIG.FEATURE_SWITCHES.LIVE_CONNECTOR) {
      validation.mode = "SNAPSHOT_ONLY";
      validation.detail = "Live connector disabled by feature switch.";
      return Promise.resolve({ ok: false, table: null });
    }
    return attempt(1);
  }

  function getValidation() { return JSON.parse(JSON.stringify(validation)); }

  return { connect: connect, getValidation: getValidation };
})();

/* =============================================================================
 * Runtime Data Binding Module
 * Authority : RC-06 §11 Data Binding Specification
 *             RC-06A §13 Production Compiler Obligations
 * Rules     : binds only approved datasets; preserves field names; validates
 *             data before rendering; never infers additional datasets and
 *             never aggregates outside approved KPI definitions.

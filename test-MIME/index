.status-chip { font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; padding: 2px 7px; border-radius: var(--radius-pill); white-space: nowrap; }
.status-chip--good     { background: #E4F4EC; color: var(--color-status-success); }
.status-chip--watch    { background: #FCEFD9; color: var(--color-status-warning); }
.status-chip--action   { background: #FBE4E2; color: var(--color-status-critical); }
.status-chip--critical { background: #F1DADA; color: var(--color-status-escalate); }
.status-chip--na       { background: #EEF0F3; color: var(--color-status-neutral); }


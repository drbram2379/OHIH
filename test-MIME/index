.kpi-card__delta { font-size: var(--type-caption); margin-top: 6px; font-weight: 600; }
.kpi-card__delta--up   { color: var(--color-status-critical); }
.kpi-card__delta--down { color: var(--color-status-success); }
.kpi-card__delta--flat { color: var(--color-status-neutral); }
.kpi-card__source { font-size: var(--type-footnote); color: #AEB8C4; margin-top: var(--space-s); font-family: var(--type-family-mono); }


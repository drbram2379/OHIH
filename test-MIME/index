.verdict { background: linear-gradient(135deg, var(--color-brand-primary), #123A63); color: #fff; border-radius: 10px; padding: var(--space-l) 26px; display: flex; gap: var(--space-l); align-items: center; box-shadow: var(--elevation-card); flex-wrap: wrap; }
.verdict__badge { width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--type-family-display); font-weight: 800; font-size: 1.4rem; flex: none; border: 3px solid rgba(255,255,255,.35); }
.verdict__body h3 { color: #fff; font-size: var(--type-h1); margin-bottom: 6px; }
.verdict__body p { margin: 0; color: #D7E1EC; font-size: var(--type-body); max-width: 860px; }
.verdict__cite { color: #9FB3C8; font-size: var(--type-footnote); margin-top: var(--space-s); font-family: var(--type-family-mono); }

/* --- C2 KPI Components -------------------------------------------------- */

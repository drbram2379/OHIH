.data-table { width: 100%; border-collapse: collapse; font-size: var(--type-caption); }
.data-table th { text-align: left; background: var(--color-surface-muted); color: var(--color-text-secondary); font-weight: 700; font-size: var(--type-footnote); text-transform: uppercase; letter-spacing: .4px; padding: 8px 10px; border-bottom: 2px solid var(--color-border); }
.data-table td { padding: 8px 10px; border-bottom: 1px solid var(--color-border); }
.data-table tr:hover td { background: #FAFBFD; }
.table-scroll { overflow-x: auto; }

.tag { display: inline-block; padding: 1.5px 7px; border-radius: 4px; background: #EEF1F5; font-size: var(--type-footnote); color: var(--color-text-secondary); font-family: var(--type-family-mono); }

/* --- C7 Narrative ------------------------------------------------------- */
.narrative section { margin-bottom: var(--space-m); }
.narrative__label { font-size: var(--type-footnote); text-transform: uppercase; letter-spacing: .5px; color: var(--color-brand-accent); font-weight: 700; margin-bottom: 4px; }
.narrative p { margin: 0 0 10px; font-size: var(--type-body); color: #31404F; }

/* --- C9 Governance ------------------------------------------------------ */
.gov-row { display: flex; justify-content: space-between; gap: var(--space-m); padding: 9px 0; border-bottom: 1px solid var(--color-border); font-size: var(--type-caption); }
.gov-row:last-child { border-bottom: none; }
.gov-row__key { color: var(--color-text-secondary); }
